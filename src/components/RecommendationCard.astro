---
import Icon from './Icon.astro';
import RepositoryIcon from './RepositoryIcon.astro';
interface Props { item: import('../lib/works.mjs').Work }
const {item} = Astro.props;
---
<a class="recommendation" href={item.toolUrl || item.url} data-repository={item.repository}><span class="recommendation-icon"><RepositoryIcon image={item.image} icon={item.icon} size={21}/></span><span class="recommendation-copy"><strong>{item.name}</strong><span class="recommendation-description">{item.description}</span></span><Icon name="arrow" size={17}/></a>
