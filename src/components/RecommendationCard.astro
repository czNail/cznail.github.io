---
import Icon from './Icon.astro';
import RepositoryIcon from './RepositoryIcon.astro';
interface Props { item:{name:string;description:string;url:string;icon:string;image?:string}; repo:{name:string;stars:number;lastCommitAt:string|null;recentCommits:number}; featured?:boolean }
const {item,repo,featured=false}=Astro.props;
const date = (value:string) => new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit'}).format(new Date(value));
---
<a class:list={['recommendation',{featured}]} href={item.url} data-repository={repo.name}><span class="recommendation-icon"><RepositoryIcon image={item.image} icon={item.icon} size={21}/></span><span class="recommendation-copy"><strong>{item.name}</strong><span class="recommendation-description">{item.description}</span><small>{repo.stars>0 && <span>☆ {repo.stars}</span>}{repo.lastCommitAt && <time datetime={repo.lastCommitAt}>{date(repo.lastCommitAt)} 更新</time>}</small></span><Icon name="arrow" size={17}/></a>
