---
import Icon from './Icon.astro';
import PatternArt from './PatternArt.astro';
interface Props { project: {repository:string;name:string;label:string;description:string;tags:string[];url:string;icon:string;image?:string} }
const {project}=Astro.props;
---
<a class="project-card" href={project.url} data-repository={project.repository}>
  <PatternArt image={project.image} />
  <div class="project-body">
    <div class="card-top"><span class="card-kind">{project.label}</span><Icon name="arrow" size={18}/></div>
    <h3>{project.name}</h3><p>{project.description}</p>
    <ul class="tags" aria-label="项目技术标签">{project.tags.map(tag => <li>{tag}</li>)}</ul>
    <span class="source-link">查看源码 <Icon name="arrow" size={14}/></span>
  </div>
</a>
