---
import Icon from './Icon.astro';
interface Props { project: {repository:string;name:string;label:string;description:string;tags:string[];url:string;icon:string} }
const {project}=Astro.props;
---
<a class="project-card" href={project.url} data-repository={project.repository}><div class="card-top"><span class="project-icon"><Icon name={project.icon} size={24}/></span><span class="card-kind">{project.label}</span><Icon name="arrow" size={20}/></div><h3>{project.name}</h3><p>{project.description}</p><ul class="tags" aria-label="项目技术标签">{project.tags.map(tag => <li>{tag}</li>)}</ul></a>
