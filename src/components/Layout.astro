---
import '../styles/global.css';
import { headerMarkup, footerMarkup } from '../../packages/site-ui/shell.mjs';
import WeChatDialog from './WeChatDialog.astro';
import { tools } from '../data/site';
interface Props { title?: string; description?: string; }
const { title = '木匠钉子 · Neil Chen', description = '木匠钉子(Neil Chen)的个人主页：技术写作、开源项目与实用工具。' } = Astro.props;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#edf0e9" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <title>{title}</title>
    <script is:inline src="/site-ui/runtime.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Fragment set:html={headerMarkup({ active: Astro.url.pathname === "/" ? "home" : Astro.url.pathname.startsWith('/games') ? 'games' : "", tools, staticTools: true })} />
    <script is:inline src="/tools-menu.js" defer></script>
    <slot />
    <Fragment set:html={footerMarkup()} />
    <WeChatDialog />
  </body>
</html>

