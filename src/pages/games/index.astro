---
import Layout from '../../components/Layout.astro';
import Icon from '../../components/Icon.astro';
import { games } from '../../data/site';
---
<Layout title="小游戏 · 木匠钉子" description="打开浏览器，玩一会儿。木匠钉子的小游戏：云端平衡球，支持键盘和触屏。">
  <main id="main" class="wrap games-page">
    <a class="text-link games-back" href="/">← 返回个人主页</a>
    <div class="games-heading"><p class="eyebrow">PLAY / A LITTLE BREAK</p><h1>换个节奏，玩一会儿<span class="heading-dot">.</span></h1><p>把注意力从文字和代码里抽出来，留给一点轻松的挑战。</p></div>
    <div class="games-grid">
      {games.map(game => <article class="game-card" data-repository={game.repository}>
        <a class="game-preview" href={game.toolUrl} aria-label={`开始游戏：${game.name}`}><img src={game.preview || game.image} alt={game.previewAlt || game.name} width="960" height="540" decoding="async"/><span class="game-play" aria-hidden="true">▷</span></a>
        <div class="game-copy"><p class="eyebrow">01 / 平衡与专注</p><h2>{game.name}</h2><p>{game.description}</p><ul class="tags" aria-label="游戏特点">{game.features.map(feature => <li>{feature}</li>)}</ul><div class="game-actions"><a class="button primary" href={game.toolUrl}>开始游戏 <Icon name="right" size={17}/></a><a class="text-link" href={game.url}>查看源码 <Icon name="arrow" size={15}/></a></div><p class="game-controls">方向键 / WASD 移动 · 空格刹车 · 手机使用触屏摇杆</p></div>
      </article>)}
      {!games.length && <p class="section-note">目前没有公开展示的小游戏。</p>}
    </div>
    <p class="games-note">无需登录，打开就能玩。成绩保存在当前浏览器中。</p>
  </main>
</Layout>
<style>
  .games-page{padding-top:35px;padding-bottom:30px;min-height:70vh}.games-back{font-size:12px;color:var(--muted)}.games-heading{margin:38px 0 32px}.games-heading .eyebrow{margin-bottom:12px;color:var(--accent)}.games-heading h1{font-size:35px;margin-bottom:13px;letter-spacing:-.03em}.games-heading>p:last-child{font-size:15px;color:var(--muted)}.games-grid{display:grid;gap:25px}.game-card{display:grid;grid-template-columns:1.12fr 1fr;overflow:hidden;border:1px solid var(--line);border-radius:var(--site-radius-card);background:var(--card)}.game-preview{position:relative;min-height:290px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:var(--soft)}.game-preview img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .3s}.game-preview:hover img{transform:scale(1.025)}.game-play{position:absolute;left:24px;bottom:23px;border:1px solid #ffffffa0;background:#f4f6eac0;color:#355e4e;width:43px;height:43px;border-radius:50%;display:grid;place-items:center;backdrop-filter:blur(8px);font-size:23px}.game-copy{padding:32px 35px}.game-copy>.eyebrow{font-size:9px;margin-bottom:13px}.game-copy h2{font-size:25px;letter-spacing:-.015em;margin-bottom:12px}.game-copy>p:not(.eyebrow){font-size:14px;line-height:1.9;color:var(--muted)}.game-copy .tags{margin:19px 0 26px}.game-actions{display:flex;align-items:center;gap:25px}.game-actions>.text-link{font-size:12px;color:var(--muted)}.game-copy>.game-controls{font-size:10px!important;margin:18px 0 0}.games-note{font-size:12px;color:var(--muted);margin:24px 0 0}@media(max-width:700px){.games-page{padding-top:25px}.games-heading{margin:30px 0 25px}.games-heading h1{font-size:27px}.games-heading>p:last-child{font-size:14px;line-height:1.9}.game-card{grid-template-columns:1fr}.game-preview{min-height:0;aspect-ratio:16/9}.game-copy{padding:24px}.game-copy h2{font-size:22px}.game-copy>p:not(.eyebrow){font-size:13px}.game-controls{line-height:1.8}.game-actions{gap:20px}}@media(prefers-reduced-motion:reduce){.game-preview img{transition:none}}
</style>
