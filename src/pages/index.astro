---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import { profile, projects, tools } from '../data/site';
import { posts } from '../data/posts';
import snapshot from '../data/repositories.json';
import { rankRepositories } from '../lib/recommendations.mjs';
const recommended = rankRepositories(snapshot.repositories).slice(0,3);
const date = (value:string) => new Intl.DateTimeFormat('zh-CN',{timeZone:'Asia/Shanghai',month:'2-digit',day:'2-digit'}).format(new Date(value));
const display = (repo:(typeof recommended)[number]) => {
  const project=projects.find(item => item.url.toLowerCase()===repo.url.toLowerCase());
  const tool=tools.find(item => item.repository===repo.name && item.status==='available');
  return {name:tool?.name ?? project?.name ?? repo.name,description:tool?.description ?? project?.description ?? repo.description,url:tool?.url ?? repo.url,icon:tool?'grid':project?.icon ?? 'code'};
};
---
<Layout>
  <main id="main" class="wrap">
    <section class="hero" id="top" aria-labelledby="intro">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-line"></span> NEIL CHEN / PERSONAL SPACE</p>
        <h1 id="intro">我是木匠钉子<span class="english">(Neil Chen)</span></h1>
        <div class="hero-links"><a class="button primary" href="#projects">浏览项目 <Icon name="right" size={18}/></a><a class="text-link" href={profile.blog}>阅读博客 <Icon name="right" size={17}/></a></div>
      </div>
      <aside class="recommendations" aria-labelledby="recommendations-title">
        <div class="recommendation-heading"><h2 id="recommendations-title">值得一看</h2><span>关注度与近期维护</span></div>
        <div class="recommendation-list">{recommended.length===0 && <p class="recommendation-empty">暂时没有可推荐的公开项目。<a href={profile.github}>去 GitHub 看看 →</a></p>}{recommended.map((repo,index) => {const item=display(repo);return <a class:list={['recommendation',{featured:index===0}]} href={item.url}><span class="recommendation-icon"><Icon name={item.icon} size={21}/></span><span class="recommendation-copy"><strong>{item.name}</strong><span class="recommendation-description">{item.description}</span><small>{repo.stars>0 && <span>☆ {repo.stars}</span>}{repo.lastCommitAt && <time datetime={repo.lastCommitAt}>{date(repo.lastCommitAt)} 更新</time>}{repo.recentCommits>0 && <span>近 30 天 {repo.recentCommits}{repo.recentCommits>=20?'+':''} 次提交</span>}</small></span><Icon name="arrow" size={17}/></a>;})}</div>
        <p class="recommendation-note">每日同步 GitHub<span>数据更新于 {date(snapshot.fetchedAt)}</span></p>
      </aside>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <div class="section-heading"><div><p class="eyebrow">01 / PROJECTS</p><h2 id="projects-title">动手做点东西</h2></div><a class="text-link" href={profile.github}>GitHub <Icon name="arrow" size={16}/></a></div>
      <div class="project-grid">{projects.map(project => <a class="project-card" href={project.url}><div class="card-top"><span class="project-icon"><Icon name={project.icon} size={24}/></span><span class="card-kind">{project.label}</span><Icon name="arrow" size={20}/></div><h3>{project.name}</h3><p>{project.description}</p><ul class="tags" aria-label="项目技术标签">{project.tags.map(tag => <li>{tag}</li>)}</ul></a>)}</div>
    </section>

    <section class="writing section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading"><div><p class="eyebrow">02 / WRITING</p><h2 id="writing-title">写下思考</h2></div><a class="text-link" href={profile.blog}>全部文章 <Icon name="arrow" size={16}/></a></div>
      <div class="post-list">{posts.map((post, index) => <a class="post" href={post.url}><span class="post-index">0{index + 1}</span><div class="post-content"><div class="post-meta"><span>{post.category}</span><time datetime={post.date}>{post.date.replaceAll('-', '.')}</time></div><h3>{post.title}</h3><p>{post.description}</p></div><span class="post-arrow"><Icon name="arrow" size={22}/></span></a>)}</div>
    </section>

    <section class="section tools-section" id="tools" aria-labelledby="tools-title">
      <div class="section-heading"><div><p class="eyebrow">03 / TOOLS</p><h2 id="tools-title">顺手的小工具</h2></div><span class="section-note">从实际需要出发</span></div>
      <div class="tools-grid">{tools.map(tool => <article class="utility-card"><div class="utility-heading"><span class="utility-icon"><Icon name="grid" size={23}/></span><span class:list={['status',{ready:tool.status==='available'}]}><i></i>{tool.status==='available'?'可使用':'开发中'}</span></div><h3>{tool.name}</h3><p class="utility-subtitle">{tool.subtitle}</p><p>{tool.description}</p><ul class="tool-features">{tool.features.map(feature => <li>{feature}</li>)}</ul>{tool.status==='available' && tool.url ? <a class="button primary" href={tool.url}>打开工具 <Icon name="right" size={17}/></a> : <p class="tool-pending">正在打磨，完成后在这里见。</p>}</article>)}</div>
    </section>

    <div class="end-note"><span class="tiny-line"></span><p>思考留在文字里，想法落在代码中。</p></div>
  </main>
</Layout>
