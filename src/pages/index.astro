---
import Layout from '../components/Layout.astro';
import CatalogMore from '../components/CatalogMore.astro';
import { catalogPreview, previewLimits } from '../lib/catalog-preview.mjs';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import RecommendationCard from '../components/RecommendationCard.astro';
import { profile, works, featuredWork } from '../data/site';
import { posts } from '../data/posts';
const featuredPost = posts[0];
const projectList = catalogPreview(works, 'projects');
---
<Layout>
  <main id="main" class="wrap">
    <section class="hero" id="top" aria-labelledby="intro">
      <div class="hero-copy">
        <p class="eyebrow"><span class="tiny-line"></span> NEIL CHEN / PERSONAL SPACE</p>
        <div class="hero-identity">
          <div class="avatar-frame"><img class="hero-avatar" src={profile.avatar} alt="木匠钉子的头像：吃泡面的鲨鱼" width="258" height="219" decoding="async" /></div>
          <div class="hero-identity-text"><h1 id="intro">我是木匠钉子<span class="english">Neil Chen</span></h1><p class="hero-introduction">{profile.tagline}</p></div>
        </div>
        <p class="hero-description">{profile.description}</p>
        <div class="hero-links"><a class="button primary" href="#projects">浏览作品 <Icon name="right" size={18}/></a><a class="text-link" href={profile.blog}>阅读博客 <Icon name="right" size={17}/></a></div>
        <div class="hero-social"><a href={profile.wechat.url} data-wechat-open><Icon name="wechat" size={18}/> 公众号 · 木匠钉子</a><span>与博客同步更新</span></div>
      </div>
      <aside class="recommendations" aria-labelledby="recommendations-title">
        <div class="recommendation-heading"><h2 id="recommendations-title">值得一看</h2><span>文字与代码</span></div>
        <a class="featured-reading" href={featuredPost.url}><span class="reading-symbol"><Icon name="book" size={22}/></span><span><small>代表文章 / {featuredPost.category}</small><strong>{featuredPost.title}</strong><span class="featured-reading-description">{featuredPost.description}</span></span><Icon name="arrow" size={17}/></a>
        {featuredWork && <><div class="recommendation-divider"><span>代表作品</span></div><RecommendationCard item={featuredWork}/></>}
        <a class="aside-more" href="#writing">更多技术文章 <Icon name="right" size={15}/></a>
      </aside>
    </section>

    <section class="section" id="projects" aria-labelledby="projects-title">
      <span id="tools" class="anchor-alias" aria-hidden="true"></span>
      <div class="section-heading"><div><p class="eyebrow">01 / WORKS</p><h2 id="projects-title">动手做点东西<span class="heading-dot">.</span></h2></div><a class="text-link" href={profile.github}>全部源码 <Icon name="arrow" size={16}/></a></div>
      <p class="section-description">自己用得上的工具，也分享给你。选一个，打开试试。</p>
      <div class="project-grid" data-catalog-preview="projects">{projectList.preview.map(project => <ProjectCard project={project}/>)}{!works.length && <p class="section-note">暂时没有可展示的公开作品。</p>}</div>
      <CatalogMore kind="projects" total={projectList.total} hasMore={projectList.remaining.length > 0}>{projectList.remaining.map(project => <ProjectCard project={project}/>)}</CatalogMore>
    </section>

    <section class="writing section" id="writing" aria-labelledby="writing-title">
      <div class="section-heading"><div><p class="eyebrow">02 / WRITING</p><h2 id="writing-title">写下思考<span class="heading-dot">.</span></h2></div><a class="text-link" href={profile.blog}>全部文章 <Icon name="arrow" size={16}/></a></div>
      <div class="writing-grid">
        <a class="featured-post" href={featuredPost.url}>
          {featuredPost.cover && <div class="post-cover"><img src={featuredPost.cover.src} alt={featuredPost.cover.alt} width={featuredPost.cover.width} height={featuredPost.cover.height} loading="lazy" decoding="async" /></div>}
          <div class="featured-post-copy"><div class="post-meta"><span>{featuredPost.category}</span><time datetime={featuredPost.date}>{featuredPost.date.replaceAll('-', '.')}</time><span class="post-picked">精选</span></div><h3>{featuredPost.title}</h3><p>{featuredPost.description}</p><span class="read-more">读这篇文章 <Icon name="right" size={17}/></span></div>
        </a>
        <div class="post-list">{posts.slice(1, previewLimits.posts).map((post, index) => <a class="post" href={post.url}><div class="post-meta"><span>{post.category}</span><time datetime={post.date}>{post.date.replaceAll('-', '.')}</time><span class="post-index">0{index + 2}</span></div><h3>{post.title}</h3><p>{post.description}</p><span class="read-more">继续阅读 <Icon name="right" size={16}/></span></a>)}</div>
      </div>
      <div class="writing-follow"><span><Icon name="wechat" size={18}/> 这些文章，也在公众号同步更新。</span><a class="text-link" href={profile.wechat.url} data-wechat-open>关注木匠钉子 <Icon name="arrow" size={15}/></a></div>
    </section>

    <div class="end-note"><span class="tiny-line"></span><p>思考留在文字里，想法落在代码中。</p></div>
  </main>
  <script>
    import { startImageFallbacks } from '../lib/repository-images';
    startImageFallbacks();
  </script>
</Layout>
